[Unit]
Description=ROBODİ Web Dashboard
After=network.target robodi.service
Wants=robodi.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/robodi
Environment="PYTHONPATH=/home/pi/robodi"
EnvironmentFile=/home/pi/robodi/.env
ExecStart=/home/pi/robodi/venv/bin/python web/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
